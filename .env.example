# URL base do Gestão de Tarefas (Laravel)
GESTAO_TAREFAS_API_URL=https://seu-servidor-de-gestao.exemplo

# Valor de autenticação. Para a aplicação atual, use a sessão web gerada por `npm run setup`.
# O MCP também aceita um Personal Access Token Sanctum para rotas que o suportem.
GESTAO_TAREFAS_API_TOKEN=cole_a_sessao_web_ou_token_sanctum_aqui

# Caminho para o banco de dados SQLite da fila offline
OFFLINE_QUEUE_PATH=~/.gestao-tarefas-mcp/queue.sqlite

# Timeout para requisições HTTP em milissegundos
REQUEST_TIMEOUT_MS=5000

# Desativar eventos e MCP automaticamente para projetos da Prefeitura / Externos (default: true)
IGNORE_PREFEITURA=true

# Padrões de nomes/repositórios para ignorar automaticamente (separados por vírgula)
IGNORED_PROJECT_PATTERNS=prefeitura,pmsp,pref-,pm-,pm_
