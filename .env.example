# URL base do Gestão de Tarefas
GESTAO_TAREFAS_API_URL=https://seu-servidor-de-gestao.exemplo

# Valor de autenticação. Para a aplicação atual, use a sessão web gerada por `npm run setup`.
# O MCP também aceita um token de acesso para rotas que o suportem.
GESTAO_TAREFAS_API_TOKEN=cole_a_sessao_web_ou_token_aqui

# Caminho para o banco de dados SQLite da fila offline
OFFLINE_QUEUE_PATH=~/.gestao-tarefas-mcp/queue.sqlite

# Timeout para requisições HTTP em milissegundos
REQUEST_TIMEOUT_MS=5000

# Ativa o bypass por padrões de nomes pessoais ou externos.
# Projetos da Prefeitura permanecem ativos por padrão.
IGNORE_EXTERNAL_PROJECTS=true

# Padrões de nomes/repositórios externos ou pessoais para ignorar automaticamente
IGNORED_PROJECT_PATTERNS=pessoal,personal,externo
